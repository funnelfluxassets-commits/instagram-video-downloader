# Notification Email (Defaults to funnelflux.assets@gmail.com)
NOTIFICATION_EMAIL=funnelflux.assets@gmail.com

# Resend API Key for automatic signup email alerts (Get free at https://resend.com)
RESEND_API_KEY=re_your_api_key_here

# Firebase Web Client Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin SDK Service Account JSON string
FIREBASE_SERVICE_ACCOUNT=

# Instagram Session Cookies (Optional for restricted media)
INSTAGRAM_COOKIES=
